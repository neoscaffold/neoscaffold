<div class="neo-prompt-bar" data-test-prompt-bar>
  <form class="npb-form" {{on "submit" this.submit}}>
    <input
      type="text"
      class="npb-input"
      placeholder="Describe a workflow, e.g. concatenate &quot;hello&quot; and &quot;world&quot; then log it"
      value={{this.promptText}}
      {{on "input" this.updatePrompt}}
      data-test-prompt-input
      disabled={{this.isBuilding}}
    />
    <button
      type="submit"
      class="npb-submit"
      disabled={{this.isSubmitDisabled}}
      data-test-prompt-submit
    >
      {{if this.isBuilding "Building…" "Generate"}}
    </button>
  </form>

  {{#if this.isDone}}
    <div class="npb-result" data-test-prompt-result>
      <div class="npb-summary">
        Added {{this.createdCount}} node(s)
        {{#if this.source}}<span class="npb-source">({{this.source}})</span>{{/if}}
      </div>
      {{#if this.plan}}
        <ol class="npb-plan" data-test-prompt-plan>
          {{#each this.plan as |step|}}
            <li>{{step}}</li>
          {{/each}}
        </ol>
      {{/if}}
      {{#if this.warnings}}
        <ul class="npb-warnings">
          {{#each this.warnings as |warning|}}
            <li>{{warning}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </div>
  {{/if}}

  {{#if this.isError}}
    <div class="npb-error" data-test-prompt-error>{{this.errorMessage}}</div>
  {{/if}}
</div>
